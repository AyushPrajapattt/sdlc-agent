# Copy to .env. Never commit .env.
# Only Neo4j is required here: GitHub/Jira/Slack/AI-model keys are entered per workspace in the UI.
# Everything below the Neo4j block is an optional environment FALLBACK for keys not saved in a workspace.
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hackfront-dev
NEO4J_DATABASE=neo4j

# Where workspaces, saved keys and investigations are kept: "file" (default: local .hackfront/ folder) or "neo4j"
# (stateless hosting). "neo4j" also needs HACKFRONT_SECRET_KEY: any long random string; it encrypts API keys saved in
# the UI. Copy local state across with: uv run hackfront migrate-state
HACKFRONT_STATE=file
HACKFRONT_SECRET_KEY=
# Public API only: require this bearer token on every /api call (the Vercel proxy adds it)
HACKFRONT_ACCESS_TOKEN=

# LLM: azure | sarvam
LLM_PROVIDER=azure
LLM_MODEL=Kimi-K2.5
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
SARVAM_API_KEY=

# Sources (only needed for live sync; demo mode needs none)
GITHUB_TOKEN=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
